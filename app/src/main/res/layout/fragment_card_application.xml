<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mb_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar: Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Cancel"
                android:textColor="@color/mb_ink_soft"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mb_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Heading -->
            <TextView
                android:id="@+id/cardEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Infinite Card"
                android:textColor="@color/mb_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Application"
                android:textColor="@color/mb_ink"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One step — no wizard."
                android:textColor="@color/mb_ink_soft"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Form card -->
            <LinearLayout
                android:id="@+id/formView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/mb_surface_card"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <TextView style="@style/MbFieldLabel" android:text="Full name" />
                <EditText
                    android:id="@+id/fullNameEditText"
                    style="@style/MbInput"
                    android:hint="Priya Sharma"
                    android:inputType="textPersonName" />

                <TextView style="@style/MbFieldLabel" android:text="Email" android:layout_marginTop="14dp" />
                <EditText
                    android:id="@+id/emailEditText"
                    style="@style/MbInput"
                    android:hint="priya.sharma@email.com"
                    android:inputType="textEmailAddress" />

                <TextView style="@style/MbFieldLabel" android:text="Phone number" android:layout_marginTop="14dp" />
                <EditText
                    android:id="@+id/phoneEditText"
                    style="@style/MbInput"
                    android:hint="+91 98••• •••21"
                    android:inputType="phone" />

                <TextView style="@style/MbFieldLabel" android:text="Monthly income" android:layout_marginTop="14dp" />
                <EditText
                    android:id="@+id/incomeEditText"
                    style="@style/MbInput"
                    android:hint="₹ 1,20,000"
                    android:inputType="text" />

                <TextView style="@style/MbFieldLabel" android:text="PAN" android:layout_marginTop="14dp" />
                <EditText
                    android:id="@+id/panEditText"
                    style="@style/MbInput"
                    android:hint="ABCD•••••F"
                    android:inputType="textCapCharacters" />

                <TextView style="@style/MbFieldLabel" android:text="Address" android:layout_marginTop="14dp" />
                <EditText
                    android:id="@+id/addressEditText"
                    style="@style/MbInput"
                    android:hint="12 MG Road, Bengaluru"
                    android:inputType="textPostalAddress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginTop="14dp">

                    <CheckBox
                        android:id="@+id/agreeCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="I agree to the terms &amp; conditions and consent to a credit check."
                        android:textColor="@color/mb_ink_soft"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/mb_btn_navy"
                    android:text="Submit Application"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Success state -->
            <LinearLayout
                android:id="@+id/successView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/mb_teal"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Application submitted"
                    android:textColor="@color/mb_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We'll review your application and get back to you shortly."
                    android:textColor="@color/mb_ink_soft"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
