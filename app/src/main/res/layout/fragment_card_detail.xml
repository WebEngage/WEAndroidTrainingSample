<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mb_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar: Back to Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back to Cards"
                android:textColor="@color/mb_ink_soft"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mb_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Big card image -->
            <ImageView
                android:id="@+id/cardArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:src="@drawable/meridian_premium_infinite" />

            <!-- What you get -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What you get"
                android:textColor="@color/mb_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/featuresContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Annual fee surface row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/mb_surface_card"
                android:padding="18dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/annualFeeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Annual fee"
                    android:textColor="@color/mb_ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/annualFeeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹9,999 + GST"
                    android:textColor="@color/mb_ink"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/startApplicationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/mb_btn_navy"
                android:text="Start Application"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
